NANSEN_API_KEY=replace-me
NANSEN_MODE=replay              # replay | live
DAILY_CREDIT_BUDGET=3000
CHAINS=solana,base,bnb,robinhood
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=sqlite:////data/lp-radar.db
DOMAIN=                        # public host name; HTTPS is automatic, e.g. 34.12.56.78.sslip.io
DASHBOARD_USERS_B64=           # base64 of lines "username bcrypt-hash", enforced by Caddy (docs/deploy.md)
ALLOW_NO_AUTH=                 # 1 only for a local test without a login
LOG_LEVEL=INFO
DASHBOARD_BASE_URL=            # e.g. https://radar.example.com, used for links in alerts
